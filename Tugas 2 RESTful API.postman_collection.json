  "item": [
    {
      "name": "CRUD",
      "item": [
        {
          "name": "GET semua booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 200', function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test('Response berupa array', function () {\r\n    const jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.be.an('array');\r\n});\r\n\r\npm.test('Setiap data memiliki id dan namaPemesan', function () {\r\n    const jsonData = pm.response.json();\r\n\r\n    jsonData.forEach((item) => {\r\n        pm.expect(item).to.have.property('id');\r\n        pm.expect(item).to.have.property('namaPemesan');\r\n    });\r\n});\r\n\r\npm.test('Response time di bawah 500ms', function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(500);\r\n});\r\n\r\npm.test('Data booking pertama dipesan oleh Tim Garuda SI', function () {\r\n    const jsonData = pm.response.json();\r\n    pm.expect(jsonData[0].namaPemesan).to.eql('Tim Garuda SI');\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/field-bookings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "field-bookings"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST tambah booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 201', function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test('Data baru memiliki id dan nama pemesan sesuai kiriman', function () {\r\n    const jsonData = pm.response.json();\r\n    const booking = jsonData.data;\r\n\r\n    pm.expect(booking).to.have.property('id');\r\n    pm.expect(booking.namaPemesan).to.eql('Reva Lina 2428240105');\r\n});\r\n\r\nif (pm.response.code === 201) {\r\n    const jsonData = pm.response.json();\r\n    pm.environment.set('bookingId', jsonData.data.id);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"namaPemesan\": \"Reva Lina 2428240105\",\"lapangan\": \"Futsal C\",\"tanggal\": \"2026-10-15\",\"jamMulai\": \"20:00\",\"durasiJam\": 2\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/field-bookings",
              "host": [
