        {
          "name": "PUT ubah booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 200', function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test('Data booking berubah, nama pemesan tetap', function () {\r\n    const jsonData = pm.response.json();\r\n    const booking = jsonData.data;\r\n\r\n    pm.expect(booking.namaPemesan).to.eql('Andi Saputra');\r\n    pm.expect(booking.lapangan).to.eql('Futsal B');\r\n});"
                ]
              }
            }
          ],
